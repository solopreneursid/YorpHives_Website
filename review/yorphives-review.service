[Unit]
Description=YorpHives website change reviewer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=yorphives-review
StateDirectoryMode=0700
WorkingDirectory=/opt/yorphives-review
Environment=YH_PLAYWRIGHT_NODE_MODULES=/opt/yorphives-review/runtime/node_modules
Environment=YH_PLAYWRIGHT_BROWSERS=/opt/yorphives-review/runtime/browsers
ExecStart=/usr/bin/python3 /opt/yorphives-review/review/bot.py watch-git --repo https://github.com/solopreneursid/YorpHives_Website.git --branch yorphives-frontend --state-dir /var/lib/yorphives-review --interval 300 --sandboxed-tests --sandboxed-browser
Restart=on-failure
RestartSec=30s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
