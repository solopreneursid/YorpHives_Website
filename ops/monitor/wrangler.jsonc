{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "yorphives-edge-watchdog",
  "main": "./worker.mjs",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "STATUS_KV",
      "id": "38f801a22e2f465688f890f7eb85c623"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
