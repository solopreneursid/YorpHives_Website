{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "yorphives-edge-static-pilot",
  "main": "../../edge/worker.mjs",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "404-page"
  },
  "analytics_engine_datasets": [
    {
      "binding": "AGENT_USAGE",
      "dataset": "yorphives_agent_usage_preview_v1"
    }
  ],
  "ratelimits": [
    {
      "name": "AGENT_GLOBAL_LIMIT",
      "namespace_id": "202611173",
      "simple": {
        "limit": 160,
        "period": 60
      }
    },
    {
      "name": "AGENT_CLIENT_LIMIT",
      "namespace_id": "202611174",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "CONTACT_GLOBAL_LIMIT",
      "namespace_id": "202611207",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "CONTACT_CLIENT_LIMIT",
      "namespace_id": "202611208",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "INSIGHTS_DB",
      "database_name": "yorphives-impact-analytics-preview",
      "database_id": "a4348abe-f618-4a59-a8b0-7f994b106e5b"
    },
    {
      "binding": "HQCONNECT_DB",
      "database_name": "yorphives-hqconnect-review",
      "database_id": "e9da9d08-5e39-4c79-809d-b0401c6c31b5"
    }
  ]
}
