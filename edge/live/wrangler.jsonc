{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "yorphives-edge-static-live",
  "main": "../../edge/worker.mjs",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "404-page"
  },
  "analytics_engine_datasets": [
    {
      "binding": "AGENT_USAGE",
      "dataset": "yorphives_agent_usage_v1"
    }
  ],
  "ratelimits": [
    {
      "name": "AGENT_GLOBAL_LIMIT",
      "namespace_id": "202611171",
      "simple": {
        "limit": 160,
        "period": 60
      }
    },
    {
      "name": "AGENT_CLIENT_LIMIT",
      "namespace_id": "202611172",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "CONTACT_GLOBAL_LIMIT",
      "namespace_id": "202611205",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "CONTACT_CLIENT_LIMIT",
      "namespace_id": "202611206",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "INSIGHTS_DB",
      "database_name": "yorphives-impact-analytics-live",
      "database_id": "e7e3e27c-8cfb-44e1-bcd5-6c3a186ceaa7"
    },
    {
      "binding": "HQCONNECT_DB",
      "database_name": "yorphives-hqconnect-live",
      "database_id": "4104b276-dff6-460b-94a4-d331dd4b1799"
    }
  ]
}
