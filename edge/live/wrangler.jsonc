{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "yorphives-edge-static-live",
  "main": "../../edge/worker.mjs",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "INSIGHTS_DB",
      "database_name": "yorphives-impact-analytics-live",
      "database_id": "e7e3e27c-8cfb-44e1-bcd5-6c3a186ceaa7"
    }
  ]
}
