# Security headers for Cloudflare Pages static assets.
# This applies only if this repository becomes the deployed Pages source.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; media-src 'self' blob:; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Navigation content changes often; do not reuse stale browser snapshots.
# CSS, images and tool bundles keep their existing caching behavior.
/
  Cache-Control: no-store
/index.html
  Cache-Control: no-store
/app.js
  Cache-Control: no-cache, max-age=0, must-revalidate
